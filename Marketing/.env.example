# ============================================================================
# Marketing — Social Command Center | متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env الحقيقي إلى Git أبداً.
# كل مفاتيح المنصات أدناه غير مطلوبة للتشغيل المحلي (النظام يعمل بمزودين
# وهميين Mock) — وهي جاهزة للتعبئة عند الربط الحقيقي لاحقاً.
# ============================================================================

# --- قاعدة البيانات (PostgreSQL عبر docker compose في هذا المجلد، منفذ 5433) ---
DATABASE_URL="postgresql://marketing:marketing_dev_password@localhost:5433/marketing_command?schema=public"
POSTGRES_USER=marketing
POSTGRES_PASSWORD=marketing_dev_password
POSTGRES_DB=marketing_command

# --- Auth.js ---
# أنشئ قيمة عشوائية: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- وضع التكاملات ---
# true = مزودون وهميون (الوضع الحالي). false = واجهات حقيقية (تتطلب المفاتيح أدناه).
INTEGRATIONS_USE_MOCK=true

# ============================================================================
# مفاتيح المنصات — راجع INTEGRATION-GUIDE.md لخطوات إنشاء كل تطبيق والأذونات
# ============================================================================

# --- Meta (Facebook + Instagram + Meta Ads) — developers.facebook.com ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- TikTok + TikTok Ads — developers.tiktok.com / business-api.tiktok.com ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=

# --- Snapchat + Snapchat Ads — businesshelp.snapchat.com/api ---
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_AD_ACCOUNT_ID=

# --- X (Twitter) — developer.x.com ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LinkedIn — developer.linkedin.com ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=

# --- Google Ads — developers.google.com/google-ads/api ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- YouTube (Data API v3) — developers.google.com/youtube ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
