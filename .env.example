# ============================================================================
# ARMOR Marketing Intelligence Hub — Environment Variables
# انسخ هذا الملف إلى .env وعدّل القيم. لا تقم أبداً برفع ملف .env الحقيقي إلى Git.
# ============================================================================

# --- Database (PostgreSQL via Docker Compose) ---
DATABASE_URL="postgresql://armor:armor_dev_password@localhost:5432/armor_marketing?schema=public"
POSTGRES_USER=armor
POSTGRES_PASSWORD=armor_dev_password
POSTGRES_DB=armor_marketing

# --- Auth.js / NextAuth ---
# أنشئ قيمة عشوائية بالأمر: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_NAME="ARMOR Marketing Intelligence Hub"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Riyadh"
NEXT_PUBLIC_DEFAULT_CURRENCY="SAR"

# --- Mock vs Real Integrations ---
# عند true يتم استخدام Mock Providers فقط (الوضع الافتراضي في MVP).
# لتفعيل ربط حقيقي لاحقاً، ضع القيمة false وأضف بيانات الاعتماد أدناه لكل منصة.
INTEGRATIONS_USE_MOCK=true

# --- Meta (Facebook / Instagram / Meta Ads) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# --- Google (Google Ads / GA4 / Search Console / YouTube / Business Profile) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GA4_PROPERTY_ID=

# --- TikTok Ads / TikTok ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Snapchat Ads ---
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# --- WhatsApp Business ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X / Twitter ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Rate limiting (sensitive operations: export, delete, bulk import) ---
RATE_LIMIT_EXPORT_PER_HOUR=20
RATE_LIMIT_IMPORT_PER_HOUR=10

# --- Field-level encryption for sensitive customer fields (optional, MVP-ready) ---
# أنشئ مفتاح بالأمر: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
